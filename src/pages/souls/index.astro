---
import Layout from '../../layouts/Layout.astro';
import {
  souls,
  categories,
  kinds,
  kindLabel,
  topSimilarSlugs,
  verificationBadge,
} from '../../lib/data';
import { url, soulUrl } from '../../lib/site';

const sorted = [...souls].sort((a, b) => a.title.localeCompare(b.title));
const difficulties = ['foundational', 'intermediate', 'advanced', 'expert'];
const clientData = sorted.map((s) => ({
  slug: s.slug,
  title: s.title,
  category: s.category,
  kind: s.kind,
  difficulty: s.difficulty,
  status: s.status,
  provenance: s.provenance,
  summary: s.summary,
  tags: s.tags,
  words: s.wordCount,
  read: s.readingTimeMinutes,
  links: s.backlinks.length,
  skills: s.skillCount,
  related: s.related.length,
  reviewers: s.reviewers.length,
  verified: s.verified,
  updated: s.updated,
  // Precomputed so the client renders the exact same badge as <SoulCard>.
  badge: verificationBadge(s),
}));
// Per-SOUL "find similar" lists (ranked slugs), for the Explore similarity picker.
const similarTop: Record<string, string[]> = Object.fromEntries(
  sorted.map((s) => [s.slug, topSimilarSlugs(s.slug, 8)]),
);
// Serialised once for the bundled filter script below. Escaping "<" keeps the
// JSON from prematurely closing the <script> tag.
const exploreJson = JSON.stringify({ data: clientData, similarTop }).replace(/</g, '\\u003c');
---

<Layout title="Explore" description="Browse every SOUL — filter by domain, difficulty, and more.">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight" style="color:var(--ink)">Explore the Atlas</h1>
    <p class="mt-2 max-w-2xl" style="color:var(--ink-soft)">
      {souls.length.toLocaleString('en-US')} ways of thinking across {categories.length} domains. Filter,
      sort, and dive in.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-2" id="controls">
      <input
        id="q"
        type="search"
        placeholder="Filter by name, tag, idea…"
        class="min-w-[14rem] flex-1 rounded-md border bg-transparent px-3 py-2 text-sm outline-none"
        style="border-color:var(--border); color:var(--ink)"
      />
      <select
        id="cat"
        class="rounded-md border bg-transparent px-2 py-2 text-sm outline-none"
        style="border-color:var(--border); color:var(--ink)"
      >
        <option value="">All domains</option>
        {
          categories.map((c) => (
            <option value={c.name}>
              {c.name} ({c.count})
            </option>
          ))
        }
      </select>
      {
        kinds.length > 1 && (
          <select
            id="kind"
            class="rounded-md border bg-transparent px-2 py-2 text-sm outline-none"
            style="border-color:var(--border); color:var(--ink)"
          >
            <option value="">All kinds</option>
            {kinds.map((k) => (
              <option value={k.kind}>
                {kindLabel(k.kind)} ({k.count})
              </option>
            ))}
          </select>
        )
      }
      <select
        id="diff"
        class="rounded-md border bg-transparent px-2 py-2 text-sm outline-none"
        style="border-color:var(--border); color:var(--ink)"
      >
        <option value="">Any level</option>
        {
          difficulties.map((d) => (
            <option value={d} class="capitalize">
              {d}
            </option>
          ))
        }
      </select>
      <select
        id="sort"
        class="rounded-md border bg-transparent px-2 py-2 text-sm outline-none"
        style="border-color:var(--border); color:var(--ink)"
      >
        <option value="az">A–Z</option>
        <option value="words">Longest</option>
        <option value="links">Most connected</option>
        <option value="updated">Recently updated</option>
      </select>
      <select
        id="sim"
        title="Show the minds most similar by content to a chosen SOUL"
        class="rounded-md border bg-transparent px-2 py-2 text-sm outline-none"
        style="border-color:var(--border); color:var(--ink); max-width:13rem"
      >
        <option value="">✨ Find similar to…</option>
        {sorted.map((s) => <option value={s.slug}>{s.title}</option>)}
      </select>
      <button
        id="skillsonly"
        type="button"
        aria-pressed="false"
        title="Show only SOULs equipped with Agent Skills"
        class="rounded-md border px-3 py-2 text-sm"
        style="border-color:var(--border); color:var(--ink-faint)"
      >
        Equipped
      </button>
      <div class="ml-auto flex rounded-md border" style="border-color:var(--border)">
        <button
          id="view-grid"
          class="px-3 py-2 text-sm"
          aria-pressed="true"
          style="color:var(--ink)">Grid</button
        >
        <button
          id="view-list"
          class="px-3 py-2 text-sm"
          aria-pressed="false"
          style="color:var(--ink-faint)">List</button
        >
      </div>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-2 text-sm" style="color:var(--ink-faint)">
      <span id="count"></span>
      <span id="simnote" class="hidden">
        · similar to <strong id="simname" style="color:var(--ink-soft)"></strong> by content
        <button id="simclear" class="ml-1 hover:underline" style="color:var(--accent)">clear</button
        >
      </span>
    </div>

    <div id="results" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <div id="empty" class="hidden py-20 text-center" style="color:var(--ink-faint)">
      No SOULs match those filters.
    </div>
  </div>

  <script type="application/json" id="explore-data" is:inline set:html={exploreJson} />
  <script>
    import { soulSigilSvg } from '../../lib/star';
    import { categoryColor } from '../../lib/colors';

    (function () {
      const payload = JSON.parse(document.getElementById('explore-data').textContent);
      const data = payload.data;
      const similarTop = payload.similarTop;
      const root = import.meta.env.BASE_URL.replace(/\/$/, '');
      const bySlug = new Map(data.map((s) => [s.slug, s]));
      const results = document.getElementById('results');
      const empty = document.getElementById('empty');
      const count = document.getElementById('count');
      const q = document.getElementById('q');
      const cat = document.getElementById('cat');
      const kind = document.getElementById('kind'); // only present with >1 kind
      const diff = document.getElementById('diff');
      const sort = document.getElementById('sort');
      const skillsOnly = document.getElementById('skillsonly');
      const sim = document.getElementById('sim');
      const simnote = document.getElementById('simnote');
      const simname = document.getElementById('simname');
      let view = 'grid';

      // The sigil is deterministic, so compute each SOUL's emblem once and reuse
      // it — filtering/sorting rebuilds the list on every keystroke.
      const sigilCache = new Map();
      function sigilFor(s) {
        let svg = sigilCache.get(s.slug);
        if (svg === undefined) {
          svg = soulSigilSvg(s, { size: 36 });
          sigilCache.set(s.slug, svg);
        }
        return svg;
      }
      function esc(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }
      function badgeHtml(s) {
        const b = s.badge || { tone: 'unverified', label: 'Unverified', title: '' };
        return b.tone === 'verified'
          ? `<span class="badge badge-verified" title="${esc(b.title)}"><span class="dot"></span>${esc(b.label)}</span>`
          : `<span class="badge badge-unverified" title="${esc(b.title)}"><span class="dot"></span>Unverified</span>`;
      }
      function card(s) {
        const c = categoryColor(s.category);
        return `<a href="${root}/souls/${s.slug}" class="card group flex flex-col gap-2 p-4 transition-transform hover:-translate-y-0.5" style="text-decoration:none">
          <div class="flex items-center justify-between gap-2">
            <span class="inline-flex items-center gap-1.5 text-xs font-medium" style="color:${c}"><span class="inline-block h-2 w-2 rounded-full" style="background:${c}"></span>${s.category}</span>
            <span class="flex items-center gap-1.5">${s.skills ? `<span class="chip" title="Equipped with Agent Skills">${s.skills} skill${s.skills === 1 ? '' : 's'}</span>` : ''}${s.difficulty ? `<span class="chip capitalize">${s.difficulty}</span>` : ''}</span>
            <span class="inline-flex items-center gap-1.5 text-xs font-medium" style="color:${c}"><span class="inline-block h-2 w-2 rounded-full" style="background:${c}"></span>${esc(s.category)}</span>
            <span class="flex items-center gap-1.5">${badgeHtml(s)}${s.difficulty ? `<span class="chip capitalize">${esc(s.difficulty)}</span>` : ''}</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="grid h-10 w-10 shrink-0 place-items-center">${sigilFor(s)}</span>
            <h3 class="text-base font-semibold leading-snug" style="color:var(--ink)">${esc(s.title)}</h3>
          </div>
          ${view === 'grid' ? `<p class="text-sm leading-relaxed" style="color:var(--ink-soft)">${esc(s.summary)}</p>` : ''}
          <div class="mt-auto flex items-center gap-3 pt-1 text-xs" style="color:var(--ink-faint)"><span>${s.read} min</span><span>·</span><span>${s.words.toLocaleString('en-US')} words</span>${s.links ? `<span>·</span><span>${s.links} links</span>` : ''}</div>
        </a>`;
      }

      function apply() {
        const term = q.value.trim().toLowerCase();
        const fc = cat.value,
          fk = kind ? kind.value : '',
          fd = diff.value,
          fs = sort.value;
        const fSkills = skillsOnly.getAttribute('aria-pressed') === 'true';
        // Similar mode: base the list on the chosen SOUL's ranked neighbours.
        const simSlug = sim.value;
        const simMode = simSlug && bySlug.has(simSlug);
        let list = simMode
          ? (similarTop[simSlug] || []).map((sl) => bySlug.get(sl)).filter(Boolean)
          : data.slice();
        list = list.filter((s) => {
          if (fc && s.category !== fc) return false;
          if (fk && s.kind !== fk) return false;
          if (fd && s.difficulty !== fd) return false;
          if (fSkills && !s.skills) return false;
          if (term) {
            const hay = (
              s.title +
              ' ' +
              s.summary +
              ' ' +
              (s.tags || []).join(' ') +
              ' ' +
              s.category
            ).toLowerCase();
            if (!hay.includes(term)) return false;
          }
          return true;
        });
        // Keep similarity rank in similar mode; otherwise honour the sort control.
        if (!simMode) {
          list.sort((a, b) => {
            if (fs === 'words') return b.words - a.words;
            if (fs === 'links') return b.links - a.links;
            if (fs === 'updated') return (b.updated || '').localeCompare(a.updated || '');
            return a.title.localeCompare(b.title);
          });
        }
        results.className =
          view === 'grid' ? 'mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3' : 'mt-5 grid gap-3';
        results.innerHTML = list.map(card).join('');
        count.textContent = simMode
          ? `${list.length} similar`
          : `${list.length} of ${data.length} SOULs`;
        empty.classList.toggle('hidden', list.length > 0);
        simnote.classList.toggle('hidden', !simMode);
        sort.disabled = !!simMode;
        sort.style.opacity = simMode ? '0.5' : '1';
        if (simMode) simname.textContent = bySlug.get(simSlug).title;
      }

      [q, cat, kind, diff, sort, sim]
        .filter(Boolean)
        .forEach((el) => el.addEventListener('input', apply));
      document.getElementById('simclear').addEventListener('click', () => {
        sim.value = '';
        apply();
      });
      skillsOnly.addEventListener('click', () => {
        const on = skillsOnly.getAttribute('aria-pressed') === 'true';
        skillsOnly.setAttribute('aria-pressed', String(!on));
        skillsOnly.style.color = !on ? 'var(--ink)' : 'var(--ink-faint)';
        skillsOnly.style.borderColor = !on ? 'var(--accent)' : 'var(--border)';
        apply();
      });
      document.getElementById('view-grid').addEventListener('click', () => {
        view = 'grid';
        setView();
      });
      document.getElementById('view-list').addEventListener('click', () => {
        view = 'list';
        setView();
      });
      function setView() {
        document.getElementById('view-grid').setAttribute('aria-pressed', view === 'grid');
        document.getElementById('view-list').setAttribute('aria-pressed', view === 'list');
        document.getElementById('view-grid').style.color =
          view === 'grid' ? 'var(--ink)' : 'var(--ink-faint)';
        document.getElementById('view-list').style.color =
          view === 'list' ? 'var(--ink)' : 'var(--ink-faint)';
        apply();
      }
      // Deep-link support: ?q= / ?category=
      const params = new URLSearchParams(location.search);
      if (params.get('category')) cat.value = params.get('category');
      if (kind && params.get('kind')) kind.value = params.get('kind');
      if (params.get('q')) q.value = params.get('q');
      if (params.get('similar') && similarTop[params.get('similar')])
        sim.value = params.get('similar');
      if (params.get('skills') === '1') {
        skillsOnly.setAttribute('aria-pressed', 'true');
        skillsOnly.style.color = 'var(--ink)';
        skillsOnly.style.borderColor = 'var(--accent)';
      }
      apply();
    })();
  </script>
</Layout>
